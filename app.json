{
  "expo": {
    "name": "Ace",
    "slug": "ace-meridian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#003580"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "so.agentpay.ace",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ace uses your microphone to listen to your voice commands for travel booking.",
        "NSSpeechRecognitionUsageDescription": "Ace uses speech recognition to understand your travel requests.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003580"
      },
      "package": "so.agentpay.ace",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "privacyPolicyUrl": "https://agentpay.so/privacy",
      "termsOfServiceUrl": "https://agentpay.so/terms"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Ace uses your microphone for voice travel booking."
        }
      ]
    ],
    "scheme": "ace"
  }
}
